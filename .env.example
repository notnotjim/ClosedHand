# Copy to .env and edit. Everything except the database is optional. The app
# boots into setup mode with nothing set, and you add keys here or in the dashboard.

# ---- Database (compose manages these; change the password for anything real) ----
POSTGRES_PASSWORD=postgres
POSTGRES_DB=closedhand

# ---- URLs / host ports ----
BASE_URL=http://localhost:3000     # where the dashboard is reachable
BOT_WS_URL=http://localhost:3001   # where the browser reaches the bot's /chat WebSocket
WEBAPP_PORT=3000
BOT_PORT=3001

# ---- Secrets (set these before exposing the app) ----
WS_AUTH_SECRET=change-me-to-a-long-random-string
# ADMIN_PASSWORD=          # optional OVERRIDE: normally you choose the dashboard password in the setup wizard
# COOKIE_SECRET=            # persist so dashboard sessions survive restarts (else random per boot)
# TOKEN_ENCRYPTION_KEY=     # encrypts stored OAuth tokens; REQUIRED if you set NODE_ENV=production
# NODE_ENV=production       # hardens the app; requires TOKEN_ENCRYPTION_KEY above

# ---- Model provider: add ONE to enable chat (boot works without it) ----
# DEEPINFRA_API_KEY=        # recommended golden path (chat + embeddings + rerank + vision)
# XAI_API_KEY=

# ---- Machinery (embeddings / enrichment / vision), if separate from the above ----
# DEEPINFRA_API_KEY=

# ---- Messaging platforms (all optional) ----
# TELEGRAM_BOT_TOKEN=       # the easiest first channel (one BotFather token)
# Sender access defaults to first-sender-claims: the first account to message the bot on a
# platform becomes its owner and everyone else is politely refused. Set an allowlist to
# extend that (extra ids are always allowed) or to restrict who may claim a fresh install.
# ALLOWED_TELEGRAM_IDS=     # comma-separated sender ids, e.g. 12345,67890
#                           # Same pattern per platform: ALLOWED_WHATSAPP_IDS / ALLOWED_DISCORD_IDS / ALLOWED_SLACK_IDS / ALLOWED_LINE_IDS

# ---- Google and other services connect through the dashboard's setup wizard ----
# ---- Operator identity ----
# CONTACT_EMAIL=            # shown on the privacy/terms pages as this instance's contact (unset = /feedback only)

# ---- Sandbox (code + browser tools; the compose sandbox service) ----
# SANDBOX_TOKEN=            # shared secret between bot and sandbox container; set a random string

# ---- CalDAV calendar (iCloud, Fastmail, Nextcloud, ...; bridge-free, no Google needed) ----
# CALDAV_USERNAME=          # the account email (for iCloud: your Apple ID)
# CALDAV_PASSWORD=          # an app-specific password (iCloud: appleid.apple.com > App-Specific Passwords)
# CALDAV_URL=               # server URL; unset = https://caldav.icloud.com
# CALDAV_CALENDAR=          # optional: calendar display name; unset = the first event calendar

# ---- Machinery overrides (advanced; the wizard normally derives these) ----
# EMBED_API_KEY=            # key for the embeddings endpoint (defaults to DEEPINFRA_API_KEY)
# ENRICH_API_KEY=           # key for enrichment/vision (defaults to DEEPINFRA_API_KEY)
# INTERNAL_LLM_API_KEY=     # key for internal chores (defaults to DEEPINFRA_API_KEY)

# ---- Local fallback models (chat-only providers; fetched on first need) ----
# LOCAL_EMBED_MODEL_ID=     # override the local embedder (default EmbeddingGemma-300M ONNX)
# LOCAL_RERANK_MODEL_ID=    # override the local reranker (default jina-reranker-v1-turbo-en, Apache-2.0)
# MODELS_DIR=               # where fetched models live (default <storage>/models)
