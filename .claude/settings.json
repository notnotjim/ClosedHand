{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/bug-queue.js\" list",
            "timeout": 10,
            "statusMessage": "Checking bug queue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/bug-queue.js\" hook",
            "asyncRewake": true,
            "timeout": 15,
            "rewakeSummary": "New bug report",
            "rewakeMessage": "A user just filed a bug report while you were working. Triage it in the background so the current work is not disturbed, then carry on."
          }
        ]
      }
    ]
  }
}